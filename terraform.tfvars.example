# For a custom environment: copy to my-env.tfvars and run
#   terraform plan -var-file=my-env.tfvars
# Ready-made settings live in environments/{dev,staging,prod}.tfvars.

aws_region   = "us-east-1"
project_name = "starter-kit"
environment  = "staging"
tags         = { Owner = "your-name" }

# Network
vpc_cidr                = "10.0.0.0/16"
az_count                = 2
nat_gateway_mode        = "single" # none | single | per_az
enable_ssm_endpoints    = false
flow_log_retention_days = 30

# Load balancer and edge
certificate_arn               = "" # ACM ARN enables HTTPS
alb_ingress_cidrs             = ["0.0.0.0/0"]
enable_deletion_protection    = false
enable_alb_access_logs        = false
alb_access_log_retention_days = 90
enable_waf                    = false
waf_rate_limit                = 2000

# Compute
instance_type          = "t3.micro"
ami_id                 = null # pin an AMI ID to control when instances roll
asg_min_size           = 1
asg_max_size           = 3
asg_desired_capacity   = 1
cpu_target_utilization = 50

# Storage and alerts
s3_force_destroy = false
alarm_email      = ""
